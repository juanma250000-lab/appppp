<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark counterpart of values-v27/themes.xml: windowLightNavigationBar needs
  API 27, so the base folder cannot declare it for API 26 devices.
-->
<resources>
    <style name="Theme.Mision" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mision_splash_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
